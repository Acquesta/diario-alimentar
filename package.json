{
  "name": "diario-alimentar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.0",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "sql.js": "^1.14.2",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test src/lib/*.test.ts",
    "build:web": "npm run build:zxing && expo export --platform web && node scripts/pwa.mjs",
    "serve:web": "node scripts/serve-dist.mjs",
    "build:taco": "node scripts/build-taco.mjs",
    "build:zxing": "node -e \"require('fs').mkdirSync('public/zxing',{recursive:true});require('fs').copyFileSync('node_modules/zxing-wasm/dist/reader/zxing_reader.wasm','public/zxing/zxing_reader.wasm')\"",
    "build:sqljs": "node -e \"for (const f of ['sql-wasm.js','sql-wasm.wasm']) require('fs').copyFileSync('node_modules/sql.js/dist/'+f, 'public/sqljs/'+f)\""
  },
  "private": true
}
